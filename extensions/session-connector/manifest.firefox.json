{
  "manifest_version": 3,
  "name": "morisoba connections",
  "version": "0.1.7",
  "description": "Connect your own X and Instagram sessions to your morisoba control plane.",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://morisoba.moe/*"
  ],
  "optional_host_permissions": [
    "https://x.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://morisoba.moe/control/"
      ],
      "js": [
        "control.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "x-chat.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sessions@morisoba.moe",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  }
}
